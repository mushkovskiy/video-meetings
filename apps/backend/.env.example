# Common application settings
PORT=4000
SALT=change-me
JWT_SECRET=change-me
UPLOAD_DIRECTORY=./uploads
# Max meeting recording size in bytes (default 100 MiB)
UPLOAD_MAX_RECORDING_SIZE=104857600

# Transcription (local Whisper via Transformers.js)
# The model is downloaded on first start (hundreds of MB) and cached in TRANSCRIPTION_CACHE_DIR
TRANSCRIPTION_MODEL=Xenova/whisper-small
TRANSCRIPTION_LANGUAGE=russian
TRANSCRIPTION_CACHE_DIR=./.cache/models
# Optional: path to a system ffmpeg (default: bundled ffmpeg-static)
FFMPEG_PATH=

# MongoDB connection
DB_MONGO_HOST=127.0.0.1
DB_MONGO_PORT=27017
DB_MONGO_NAME=video-meetings
DB_MONGO_USER=admin
DB_MONGO_PASSWORD=admin

# PostgreSQL connection
DB_POSTGRES_HOST=127.0.0.1
DB_POSTGRES_PORT=5432
DB_POSTGRES_NAME=video-meetings
DB_POSTGRES_USER=postgres
DB_POSTGRES_PASSWORD=postgres   